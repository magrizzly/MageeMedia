# Linux User/Group IDs (default first user 'charlie' is 1000:1000)
PUID=1000
PGID=1000
TZ=Europe/London

# Storage Paths
APPDATA_DIR=/opt/docker/appdata
INCOMPLETE_DIR=/opt/docker/downloads/incomplete
MEDIA_POOL=/mnt/media
VAULT_POOL=/mnt/vault

# ProtonVPN WireGuard Credentials (for Gluetun -> qBittorrent + Prowlarr)
# Generate at: https://account.protonvpn.com/downloads -> WireGuard -> GNU/Linux -> Turn ON NAT-PMP (Port Forwarding)
WIREGUARD_PRIVATE_KEY=REPLACE_WITH_PROTONVPN_WIREGUARD_PRIVATE_KEY
SERVER_COUNTRIES=United Kingdom,Netherlands,Switzerland

# Immich Photo Management Database Credentials
IMMICH_VERSION=release
DB_USERNAME=postgres
DB_PASSWORD=mageemedia_immich_postgres
DB_DATABASE_NAME=immich
